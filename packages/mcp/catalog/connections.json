{
  "version": 2,
  "connections": [
    {
      "id": "local-files",
      "label": "Local files and logs",
      "class": "free-open-source",
      "default": true,
      "auth": "filesystem scope selected by the host",
      "permissions": ["read selected paths"],
      "writes": false,
      "status": "available"
    },
    {
      "id": "git",
      "label": "Git",
      "class": "free-open-source",
      "default": true,
      "auth": "local repository permissions",
      "permissions": ["read status and history"],
      "writes": false,
      "status": "available"
    },
    {
      "id": "sqlite",
      "label": "SQLite memory",
      "class": "free-open-source",
      "default": true,
      "auth": "local file permissions",
      "permissions": ["read and write the Operations Pulse database"],
      "writes": true,
      "status": "available"
    },
    {
      "id": "imap-email",
      "label": "Standards-based email (IMAP)",
      "class": "bring-your-own-account",
      "default": false,
      "auth": "host-managed OAuth reference, or an app-password/access-token JSON value held only in a named environment variable",
      "permissions": ["read selected mailbox or folder"],
      "writes": false,
      "status": "available",
      "modes": ["host-oauth", "env-token"],
      "settings": ["host", "user", "port", "secure", "mailbox", "limit"],
      "disconnect": "operations-pulse connections disconnect --id imap-email"
    },
    {
      "id": "github",
      "label": "GitHub",
      "class": "free-or-subscription",
      "default": false,
      "auth": "existing local GitHub CLI session, host OAuth connection, or a fine-grained token held only in a named environment variable",
      "permissions": ["repository metadata", "issues and pull requests as granted"],
      "writes": "optional and separately approved",
      "status": "available",
      "modes": ["github-cli", "host-oauth", "env-token"],
      "settings": [],
      "disconnect": "operations-pulse connections disconnect --id github"
    },
    {
      "id": "linear",
      "label": "Linear",
      "class": "subscription-or-existing-license",
      "default": false,
      "auth": "host OAuth connection or a personal API key held only in a named environment variable",
      "permissions": ["issues and projects as granted"],
      "writes": "optional and separately approved",
      "status": "available",
      "modes": ["host-oauth", "env-token"],
      "settings": [],
      "disconnect": "operations-pulse connections disconnect --id linear"
    },
    {
      "id": "sentry",
      "label": "Sentry",
      "class": "free-or-subscription",
      "default": false,
      "auth": "host connection, organization token, or bearer token held only in a named environment variable",
      "permissions": ["read selected projects and events"],
      "writes": false,
      "status": "available",
      "modes": ["host-oauth", "env-token", "self-hosted"],
      "settings": ["organization"],
      "disconnect": "operations-pulse connections disconnect --id sentry"
    },
    {
      "id": "posthog",
      "label": "PostHog",
      "class": "open-source-or-cloud-subscription",
      "default": false,
      "auth": "self-hosted URL plus personal API key, or cloud connection; keys are held only in a named environment variable",
      "permissions": ["read selected projects and insights"],
      "writes": false,
      "status": "available",
      "modes": ["host-oauth", "env-token", "self-hosted"],
      "settings": ["organization", "project"],
      "disconnect": "operations-pulse connections disconnect --id posthog"
    },
    {
      "id": "model-provider",
      "label": "Optional model provider",
      "class": "local-model-or-bring-your-own-api",
      "default": false,
      "auth": "local endpoint, existing subscription, or API key",
      "permissions": ["send only the context approved for a specific run"],
      "writes": false,
      "status": "planned"
    }
  ]
}
