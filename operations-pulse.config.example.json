{
  "$schema": "./catalog/config.schema.json",
  "workspace": ".",
  "checks": {
    "git_worktree": true,
    "docs_presence": true,
    "local_logs": {
      "enabled": false,
      "paths": ["./logs/app.log"],
      "patterns": ["error", "warn", "retry", "timeout"]
    }
  },
  "ticketPolicy": {
    "createFromPulse": false,
    "defaultPriority": "medium"
  },
  "connections": {
    "github": {
      "mode": "env-token",
      "credentialEnv": "OPERATIONS_PULSE_GITHUB_TOKEN"
    },
    "sentry": {
      "mode": "self-hosted",
      "credentialEnv": "OPERATIONS_PULSE_SENTRY_TOKEN",
      "endpoint": "https://sentry.example.com",
      "settings": {
        "organization": "your-organization"
      }
    }
  }
}
