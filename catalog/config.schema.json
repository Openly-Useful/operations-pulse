{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlyuseful.org/schemas/operations-pulse-config.json",
  "title": "Operations Pulse configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace": { "type": "string" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_worktree": { "type": "boolean" },
        "docs_presence": { "type": "boolean" },
        "local_logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "paths": { "type": "array", "items": { "type": "string" } },
            "patterns": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["enabled", "paths", "patterns"]
        }
      }
    },
    "ticketPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createFromPulse": { "type": "boolean" },
        "defaultPriority": { "enum": ["low", "medium", "high", "urgent"] }
      }
    },
    "connections": { "type": "object" }
  }
}
